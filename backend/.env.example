# ERCS Backend Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials. Do not commit your '.env' file to source control.

# Application Server Port
PORT=5000

# Runtime Mode (development | production | test)
NODE_ENV=development

# MySQL Database Pool Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_database_password
DB_NAME=ercs

# Cryptographic Access JWT Signing Key (Use high entropy random string)
JWT_SECRET=your_super_secret_jwt_key

# ImageKit CDN Cloud Storage Keys (Used for media attachments uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id/

# Cross-Origin Permissions (CORS) - CSV of domains
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4200
